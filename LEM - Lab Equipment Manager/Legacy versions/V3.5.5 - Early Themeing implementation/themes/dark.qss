/* Clean Dark QSS — cohesive dark appearance for the whole UI and PyQtGraph */

/* -------- Base -------- */
QWidget {
  background: #0d1117;  /* app background */
  color: #e6edf3;       /* primary text */
  font-family: "Segoe UI", Roboto, Arial, sans-serif;
  font-size: 10pt;
}

/* Splash image (optional): relative to this file or absolute path)
   splash-image: splash.png */

QMainWindow, QDialog, QFrame, QGroupBox, QTabWidget::pane {
  background: #161b22;            /* panel surface */
  border: 1px solid #30363d;      /* subtle outline */
  border-radius: 6px;
}

/* -------- Headings / Labels -------- */
QLabel[heading="true"] { font-weight: 600; }

/* -------- Inputs -------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox,
QDateEdit, QTimeEdit, QDateTimeEdit {
  background: #0d1117;
  color: #e6edf3;
  border: 1px solid #30363d;
  border-radius: 5px;
  padding: 4px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
  border: 1px solid #2f81f7;     /* accent */
  outline: none;
}
QComboBox::drop-down { border: none; }

/* -------- Buttons -------- */
QPushButton {
  background: #21262d;
  color: #e6edf3;
  border: 1px solid #30363d;
  border-radius: 6px;
  padding: 5px 10px;
}
QPushButton:hover { background: #262b33; }
QPushButton:pressed { background: #1b1f24; }
QPushButton:disabled { color: #8b949e; border-color: #30363d; }

/* Primary button (opt-in via property) */
QPushButton[primary="true"] { background: #2f81f7; color: #ffffff; border-color: #255ab2; }
QPushButton[primary="true"]:hover { background: #2a74e3; }
QPushButton[primary="true"]:pressed { background: #2468cc; }

/* -------- Lists / Tables -------- */
QListView, QListWidget, QTreeView {
  background: #161b22;
  color: #e6edf3;
  border: 1px solid #30363d;
  border-radius: 6px;
}
QListView::item, QListWidget::item { height: 22px; }
QListView::item:selected, QListWidget::item:selected {
  background: #1f6feb;  /* selection */
  color: #ffffff;
}
QTableView {
  gridline-color: #30363d;
  background: #161b22;
  color: #e6edf3;
  border: 1px solid #30363d;
  border-radius: 6px;
  selection-background-color: #1f6feb;
  selection-color: #ffffff;
}
QHeaderView::section {
  background: #1c2128;
  color: #e6edf3;
  border: 1px solid #30363d;
  padding: 4px 6px;
}

/* -------- Tabs / Toolbars / Status -------- */
QTabBar::tab {
  background: #1c2128;
  color: #e6edf3;
  border: 1px solid #30363d;
  border-bottom: none;
  padding: 6px 10px;
  margin-right: 2px;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
}
QTabBar::tab:selected { background: #161b22; }
QToolBar { background: #161b22; border: 1px solid #30363d; }
QStatusBar { background: #161b22; border-top: 1px solid #30363d; }

/* -------- Scrollbars -------- */
QScrollBar:vertical {
  background: transparent; width: 12px; margin: 2px;
}
QScrollBar::handle:vertical { background: #484f58; border-radius: 6px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 2px; }
QScrollBar::handle:horizontal { background: #484f58; border-radius: 6px; min-width: 24px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* -------- ProgressBar -------- */
QProgressBar { background: #1c2128; border: 1px solid #30363d; border-radius: 6px; text-align: center; }
QProgressBar::chunk { background-color: #2f81f7; border-radius: 6px; }

/* -------- Menus -------- */
QMenu { background: #161b22; border: 1px solid #30363d; }
QMenu::item:selected { background: #1f6feb; }

/* -------- Tooltips -------- */
QToolTip { background: #161b22; color: #e6edf3; border: 1px solid #30363d; padding: 4px 8px; border-radius: 4px; }

/* -------- PyQtGraph (QGraphicsView / PlotWidget) -------- */
/* The PlotWidget is a QGraphicsView; keep its frame consistent with the UI. */
QGraphicsView {
  background: #161b22;              /* plot canvas background */
  border: 1px solid #30363d;        /* plot frame */
  border-radius: 6px;
}

/* Example series palette for plots
   series-colors: #4E79A7, #F28E2B, #E15759, #76B7B2, #59A14F, #EDC948, #B07AA1, #FF9DA7, #9C755F, #BAB0AC */
