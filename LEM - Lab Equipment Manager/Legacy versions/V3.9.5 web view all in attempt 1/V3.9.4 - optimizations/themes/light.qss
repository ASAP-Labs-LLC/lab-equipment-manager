/* THEME_COLORS grid_bg=#f5f5f5 grid_line=#e0e0e0 machine_green=#2ecc71 machine_red=#e74c3c machine_yellow=#f1c40f machine_black=#000000 machine_black_text=#dc143c machine_service_bg=#e6e6e6 machine_service_text=#3c3c3c machine_default_bg=#c8c8c8 machine_text_white=#ffffff machine_text_default=#1e1e1e maint_overdue_bg=#c83c3c maint_due_bg=#e6783c maint_soon_bg=#ffc878 maint_in_progress_bg=#648cc8 maint_flash_bg=#ff7878 status_flash_bg=#fff096 status_flash_alt_bg=#ffffff border_color=#212121 handle_color=#5a5a5a */
/* Global base */
* {
  font-family: Segoe UI, Arial, sans-serif;
  font-size: 10pt;
}

QMainWindow, QWidget {
  background: #fafafa;
  color: #202020;
}

QToolBar {
  background: #f0f0f0;
  border: 1px solid #dadada;
}

QDockWidget {
  titlebar-close-icon: url(none);
  titlebar-normal-icon: url(none);
}

QHeaderView::section {
  background: #f2f2f2;
  color: #202020;
  padding: 4px;
  border: 1px solid #d0d0d0;
}

QTableView {
  gridline-color: #d0d0d0;
  selection-background-color: #cce8ff;
  selection-color: #202020;
}

QPushButton {
  background: #ffffff;
  border: 1px solid #c0c0c0;
  padding: 6px 10px;
  border-radius: 4px;
}

QPushButton:hover { background: #f6f6f6; }
QPushButton:pressed { background: #eeeeee; }

QGroupBox::title { color: #404040; }
